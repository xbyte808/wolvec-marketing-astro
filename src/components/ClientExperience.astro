---
const scenarios = [
  {
    label: 'A question between sessions?',
    body: 'Depending on the chat level you choose, your AI can answer routine questions based on how you coach, draft a reply for you to review, or stay off.',
  },
  {
    label: 'Cable machine broken?',
    body: 'They tap Swap, pick from alternatives suggested for that exercise, including any substitutes you’ve set, and keep training without waiting on you. It applies to today’s session only, and you’re notified.',
  },
  {
    label: 'Hotel gym tomorrow?',
    quote: '“Hotel gym tomorrow. Can I swap the back squat for something with dumbbells?”',
    body: 'A change to an upcoming session goes through you. Asking in chat sends you the swap to approve, one exercise at a time. Approve it and it changes that exercise in that session only. The rest of their program stays as you wrote it.',
  },
  {
    label: 'Basement gym, no signal?',
    body: 'Clients can log sets during a workout without a connection, with supported workout data syncing when connectivity returns.',
  },
];
// Optional photo: renders only when src/assets/photos/client-training.(jpg|jpeg|png|webp) exists.
// Source and licence for every photo are recorded in src/assets/photos/LICENSES.md.
import { Image } from 'astro:assets';
const clientPhoto = Object.values(
  import.meta.glob('../assets/photos/client-training.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }),
)[0] as ImageMetadata | undefined;
---

<section id="client-experience" class="py-21 px-6 bg-ink">
  <div class="max-w-5xl mx-auto">
    <div class:list={['grid grid-cols-1 gap-8 items-center mb-11', clientPhoto && 'md:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]']}>
    <div>
    <p class="eyebrow eyebrow-on-ink mb-5" data-reveal>The client experience</p>
    <h2 class="section-heading text-text max-w-2xl text-[clamp(1.875rem,3vw+1rem,2.75rem)]" data-reveal style="--reveal-delay:70ms">
      Your clients can get support when you&rsquo;re not around.
    </h2>
    </div>
    {clientPhoto && (
      <figure class="photo-slot" data-reveal>
        <Image src={clientPhoto} alt="" width={900} format="webp" quality={75} class="photo-img" />
      </figure>
    )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {scenarios.map((s, i) => (
        <div class="hover-card border border-hairline-dark rounded-2xl p-6 bg-surface-1" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <h3 class="font-display text-text text-lg mb-2">{s.label}</h3>
          {s.quote && <p class="text-text-soft text-[15.5px] leading-relaxed italic mb-3">{s.quote}</p>}
          <p class="text-text-soft text-[15.5px] leading-relaxed">{s.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .photo-slot { position: relative; margin: 0; border-radius: 18px; overflow: hidden; aspect-ratio: 4 / 3; }
  .photo-img { width: 100%; height: 100%; object-fit: cover; object-position: var(--photo-pos, 50% 40%); }
</style>
