---
import Logo from '../assets/wolvec-logo.svg';
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-ink/72 backdrop-blur-md border-b border-hairline-dark">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src={Logo.src} alt="Wolvec" class="h-7 w-7" />
      <span class="hidden sm:inline font-display text-text text-xl uppercase tracking-[0.06em]">Wolvec</span>
    </a>

    <div class="hidden md:flex items-center gap-7">
      <a href="/#how-it-works" class="hover-link text-text-soft hover:text-text text-sm font-medium">
        How it works
      </a>
      <a href="/#platform" class="hover-link text-text-soft hover:text-text text-sm font-medium">
        The platform
      </a>
      <a href="/#your-control" class="hover-link text-text-soft hover:text-text text-sm font-medium">
        Your control
      </a>
      <!--
        Account controls, grouped away from the section links. Sign in routes
        to the app; there is deliberately no separate sign-up control, because
        there is no self-serve signup to route one to. Off-allowlist visitors
        reach the app's request-access screen, which is a real destination.
      -->
      <div class="flex items-center gap-5 pl-1">
        <a
          href="https://app.wolvec.ai"
          class="hover-link text-text-soft hover:text-text text-sm font-medium"
        >
          Sign in
        </a>
        <a
          href="/#early-access"
          class="hover-button bg-azure-deep hover:bg-azure-deep/90 text-white text-sm font-bold px-5 py-2.5 rounded-full"
        >
          Get early access
        </a>
      </div>
    </div>

    <!-- Mobile: logo mark + account controls only -->
    <div class="flex md:hidden items-center gap-4">
      <a
        href="https://app.wolvec.ai"
        class="hover-link text-text-soft hover:text-text text-sm font-medium"
      >
        Sign in
      </a>
      <a
        href="/#early-access"
        class="hover-button bg-azure-deep hover:bg-azure-deep/90 text-white text-sm font-bold px-4 py-2.5 rounded-full"
      >
        Get early access
      </a>
    </div>
  </div>
</nav>
