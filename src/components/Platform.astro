---
const cards = [
  {
    title: 'Programs drafted by your AI, approved by you',
    body: "Your AI drafts each program week based on how you coach and the client's intake. Edit exercises, sets, reps or structure, then approve the week before the client sees it. Or build your own workouts from the exercise library and reuse them as templates.",
  },
  {
    title: 'Nearly 1,400 exercises, demos included',
    body: 'The catalog comes with animated demos and step-by-step instructions, so you are not filming or writing them up yourself. Add your own exercises, with your own video link, when something is missing.',
  },
  {
    title: 'Weekly check-ins and workout ratings',
    body: 'Clients send a weekly check-in, so you see how their week went without chasing anyone. They can also rate how hard each workout felt.',
  },
  {
    title: 'Progress and lift history',
    body: 'Every logged set becomes history. You see what a client lifted last time and how it’s trending, without asking for a screenshot.',
  },
  {
    title: 'Supersets, circuits, AMRAP and timed work',
    body: "The AI drafts the week. You layer in supersets, circuits, AMRAP and timed work wherever you'd program them.",
  },
  {
    title: 'Reusable program templates',
    body: 'Build a program once, use it again. Stop starting from a blank page for every client.',
  },
  {
    title: 'Know who needs you',
    body: 'Your home screen puts what needs you in one place: requests waiting on your decision, new messages, reply drafts, and intakes and program weeks to review. Your client list shows where everyone stands.',
  },
  {
    title: 'Nutrition and macro logging',
    body: 'Clients log meals and track macros without leaving the platform. One more piece of the relationship that doesn’t need a separate app.',
  },
];

const byTitle = Object.fromEntries(cards.map((c) => [c.title, c]));
const groups = [
  { n: '01', name: 'Build the training', items: ['Programs drafted by your AI, approved by you', 'Nearly 1,400 exercises, demos included', 'Supersets, circuits, AMRAP and timed work', 'Reusable program templates'] },
  { n: '02', name: 'Run the week', items: ['Weekly check-ins and workout ratings', 'Nutrition and macro logging'] },
  { n: '03', name: 'Stay on top of it', items: ['Know who needs you', 'Progress and lift history'] },
].map((g) => ({ ...g, items: g.items.map((t) => { if (!byTitle[t]) throw new Error('Platform group lists a card title that does not exist: ' + t); return byTitle[t]; }) }));
---

<section id="platform" class="py-21 px-6 bg-paper-1 text-on-paper">
  <div class="max-w-5xl mx-auto">
    <p class="eyebrow mb-5" data-reveal>The platform</p>
    <h2
      class="section-heading text-on-paper max-w-2xl text-[clamp(1.875rem,3vw+1rem,2.75rem)]"
      data-reveal
      style="--reveal-delay:70ms"
    >
      One place to run your coaching.
    </h2>
    <p
      class="section-lede text-on-paper-soft text-lg max-w-2xl mb-11 text-balance"
      data-reveal
      style="--reveal-delay:140ms"
    >
      Programs, workout logging, progress, check-ins, nutrition and client chat,
      with your AI built in, all ready before your first client shows up.
    </p>

    <div class="border-t border-hairline-light">
      {groups.map((g, gi) => (
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,0.8fr)_minmax(0,2fr)] gap-x-10 gap-y-5 py-9 border-b border-hairline-light" data-reveal style={`--reveal-delay:${gi * 70}ms`}>
          <div>
            <p class="font-display text-azure-deep text-4xl leading-none mb-3">{g.n}</p>
            <h3 class="font-display text-on-paper text-[clamp(1.5rem,1.2vw+1rem,2rem)] leading-[1.05]">{g.name}</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6">
            {g.items.map((c) => (
              <div>
                <h4 class="font-display text-on-paper text-xl leading-tight mb-1.5">{c.title}</h4>
                <p class="text-on-paper-soft text-[15px] leading-relaxed">{c.body}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
