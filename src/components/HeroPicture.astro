---
// Hero picture under the hero buttons (W734): coach teaches, AI drafts and
// coach approves, client trains. Panel content lives in heroPanels.ts.
import { Image } from 'astro:assets';
import { heroPanels, heroPictureFootnote, type HeroShot } from './heroPanels';

// Wide screens: one row. Columns keep the proportions of each panel's
// `column` width at 1440px, so panel 3's phone text stays readable and panel
// 1 stays wide enough for its outline to reach 2px. Images therefore differ
// in height and align on their top edge.
const ROW_MAX = heroPanels.reduce((sum, p) => sum + p.column, 0);
const columns = heroPanels.map((p) => `minmax(0, ${p.column}fr)`).join(' ');
const narrowSizes = (p: { maxWidthStacked?: string }) =>
  `min(calc(100vw - 48px), ${p.maxWidthStacked ?? '560px'})`;

// The outline is drawn in the image's own pixels (see heroPanels.ts): a dark
// ring outside an azure stroke, both growing outward from the measured inner
// edge, so neither can reach a glyph at any rendered size.
const RING = 0.4;
const outline = (h: HeroShot['highlights'][number]) => {
  const s = h.stroke;
  const r = s * RING;
  const radius = s * 3;
  return {
    ring: { x: h.x - s - r / 2, y: h.y - s - r / 2, width: h.width + 2 * s + r, height: h.height + 2 * s + r, rx: radius + s / 2 + r / 2, strokeWidth: r },
    line: { x: h.x - s / 2, y: h.y - s / 2, width: h.width + s, height: h.height + s, rx: radius, strokeWidth: s },
  };
};
---

<div class="hero-picture" data-reveal style={`--reveal-delay:350ms;max-width:${ROW_MAX + 48}px`}>
  <div class="hero-picture-row" style={`--hero-picture-columns:${columns}`}>
    {heroPanels.map((panel) => {
      const shots = [
        { shot: panel.shot, cls: panel.narrowShots ? 'hero-wide-only' : '', sizes: `(min-width: 1024px) ${panel.column}px, ${narrowSizes(panel)}` },
        ...(panel.narrowShots ?? []).map((shot) => ({ shot, cls: 'hero-narrow-only', sizes: narrowSizes(panel) })),
      ];
      return (
        <figure
          class="hero-panel"
          style={panel.maxWidthStacked ? `--hero-panel-max:${panel.maxWidthStacked}` : undefined}
        >
          <figcaption class="hero-panel-label">{panel.label}</figcaption>
          <div class="hero-panel-shots">
            {shots.map(({ shot, cls, sizes }) => (
              <div class:list={['hero-panel-frame', cls]}>
                {/* Lazy for two reasons: a media-hidden alternate is then
                    never downloaded, and on phones, where every panel is
                    below the fold, the images stop competing with the fonts
                    the headline and subhead (the measured LCP elements) wait
                    on. Eager panels cost about 370ms of mobile LCP in
                    Lighthouse. */}
                <Image
                  src={shot.image}
                  alt={shot.alt}
                  widths={shot.widths}
                  sizes={sizes}
                  format="webp"
                  quality={80}
                  loading="lazy"
                  decoding="async"
                  class="hero-panel-image"
                />
                {shot.highlights.length > 0 && (
                  <svg
                    class="hero-panel-marks"
                    viewBox={`0 0 ${shot.image.width} ${shot.image.height}`}
                    preserveAspectRatio="none"
                    aria-hidden="true"
                  >
                    {shot.highlights.map((h) => {
                      const { ring, line } = outline(h);
                      return (
                        <>
                          <rect x={ring.x} y={ring.y} width={ring.width} height={ring.height} rx={ring.rx} fill="none" stroke="rgba(13, 14, 17, 0.7)" stroke-width={ring.strokeWidth} />
                          <rect x={line.x} y={line.y} width={line.width} height={line.height} rx={line.rx} fill="none" stroke="#3B6BFF" stroke-width={line.strokeWidth} />
                        </>
                      );
                    })}
                  </svg>
                )}
              </div>
            ))}
          </div>
        </figure>
      );
    })}
  </div>
  <p class="hero-picture-footnote">{heroPictureFootnote}</p>
</div>

<style>
  /* max-width is set inline: the three columns plus two 24px gaps. */
  .hero-picture {
    width: 100%;
    margin: 44px auto 0;
  }

  /* Narrow screens: panels stack, each centred and capped so a desktop
     capture does not stretch past a readable width. */
  .hero-picture-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .hero-panel {
    width: 100%;
    max-width: var(--hero-panel-max, 560px);
    margin: 0;
    text-align: left;
  }

  .hero-panel-label {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.35;
    color: var(--color-text);
    margin-bottom: 10px;
  }

  .hero-panel-shots {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-panel-frame {
    position: relative;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--color-hairline-dark);
    background: var(--color-surface-1);
    box-shadow: 0 24px 60px -28px rgba(0, 0, 0, 0.9);
  }

  .hero-panel-image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The one mark drawn over a screen: an azure outline around the words
     "floor session", outline only, so the captured text underneath stays
     exactly as captured. The dark ring is what keeps it visible where it
     crosses the coach's own blue bubble in panel 1. */
  .hero-panel-marks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .hero-wide-only {
      display: none;
    }
  }

  @media (min-width: 641px) {
    .hero-narrow-only {
      display: none;
    }
  }

  .hero-picture-footnote {
    margin-top: 22px;
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-text-soft);
  }

  /* Wide screens: one row. Subgrid lines the labels up on one track and the
     images on the next, so a label that wraps to two lines in the narrower
     phone column does not push its image below the others. */
  @media (min-width: 1024px) {
    .hero-picture {
      margin-top: 64px;
    }

    .hero-picture-row {
      display: grid;
      grid-template-columns: var(--hero-picture-columns);
      grid-template-rows: auto auto;
      column-gap: 24px;
      row-gap: 0;
      align-items: start;
    }

    .hero-panel {
      max-width: none;
      display: grid;
      grid-row: span 2;
      grid-template-rows: subgrid;
    }

    .hero-panel-label {
      align-self: end;
    }

    .hero-panel-shots {
      align-self: start;
    }
  }
</style>
