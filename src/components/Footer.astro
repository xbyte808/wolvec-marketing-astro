---
import Logo from '../assets/wolvec-logo.svg';
---

<footer class="border-t border-hairline-dark bg-ink">
  <div class="max-w-6xl mx-auto px-6 py-12 flex flex-col gap-8">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="flex items-center gap-2.5">
        <img src={Logo.src} alt="Wolvec" class="h-7 w-7" />
        <span class="font-display text-text text-lg uppercase tracking-[0.06em]">Wolvec</span>
      </div>

      <div class="flex flex-wrap items-center gap-x-8 gap-y-2 text-sm text-text-soft">
        <a href="/roadmap" class="hover-link hover:text-text">Roadmap</a>
        <a href="/privacy" class="hover-link hover:text-text">Privacy Policy</a>
        <a href="/consumer-health-data" class="hover-link hover:text-text">Consumer Health Data Privacy Policy</a>
        <a href="mailto:ellard@wolvec.ai" class="hover-link hover:text-text">Contact</a>
      </div>
    </div>

    <p class="text-text-soft text-xs">&copy; 2026 Wolvec L.L.C.</p>
  </div>
</footer>
