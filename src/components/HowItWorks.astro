---
import { Image } from 'astro:assets';
import interview from '../assets/how/step-1-A04-interview.png';
import draft from '../assets/how/step-3-B14b-draft.png';
import workout from '../assets/how/step-4-F34-workout.png';

const steps = [
  {
    number: '01',
    title: 'Talk it through',
    body: 'One guided conversation about how you program, progress people and talk to clients. What you explain is what your AI works from. No content library required.',
    photo: interview,
    caption: 'Leah explains her Floor Session: show up, do the floor, never zero.',
  },
  {
    number: '02',
    title: 'Bring clients in',
    body: 'Invite them, have them apply, or let them buy one of your plans on your page. Wolvec handles sign-up and intake. You just review it.',
    card: true,
    caption: 'Maya joins and completes intake. Leah approves her.',
  },
  {
    number: '03',
    title: 'A program built for each client',
    body: 'Your AI drafts it based on how you coach and what each client tells you: their goals, experience, the equipment they have and the days they can train. You approve each week before they see it.',
    photo: draft,
    caption: 'Leah’s Floor Session, in Maya’s Week 1 draft.',
  },
  {
    number: '04',
    title: 'Your coaching goes with them',
    body: 'Your notes show up inside the workout, so clients train with your cues in front of them. Routine questions get an answer based on how you coach, sent automatically or drafted for you to approve.',
    photo: workout,
    caption: 'Leah’s note, inside Maya’s Floor Session.',
  },
];
---

<section id="how-it-works" class="bg-ink">
  <div class="max-w-6xl mx-auto px-6 pt-16 pb-2">
    <p class="eyebrow eyebrow-on-ink mb-5" data-reveal>How it works</p>
    <h2 class="section-heading text-text max-w-2xl text-[clamp(1.875rem,3vw+1rem,2.75rem)]" data-reveal style="--reveal-delay:70ms">
      From one conversation to your first client.
    </h2>
  </div>

  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-12 mt-9 pb-16">
    {steps.map((step, i) => (
      <div class="flex flex-col" data-reveal style={`--reveal-delay:${i * 90}ms`}>
        <div class="step-frame">
          {step.photo && <Image src={step.photo} alt="" width={900} format="webp" quality={80} loading="eager" class="step-img" />}
          {step.card && (
            <div class="join-card">
              <p class="jc-row"><span class="jc-dot"></span>Maya accepted your invite</p>
              <p class="jc-row"><span class="jc-dot"></span>Intake done: goals, experience, equipment, days</p>
              <p class="jc-row jc-act"><span class="jc-dot"></span>Approve Maya to start</p>
            </div>
          )}
        </div>
        <p class="step-cap">{step.caption}</p>
        <p class="font-display text-azure text-4xl leading-[0.8] mt-4 mb-3">{step.number}</p>
        <h3 class="font-display text-white text-2xl mb-2">{step.title}</h3>
        <p class="text-[#CFD2D7] text-[15.5px]">{step.body}</p>
      </div>
    ))}
  </div>
  <p class="max-w-6xl mx-auto px-6 pb-14 -mt-8 text-[12px] text-[#A0A5AE]">Real Wolvec screens from an example coach account, cropped. Step 02 is an illustration.</p>
</section>
<style>
  .step-frame { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 14px; border: 1px solid rgba(255,255,255,.10); background: #16181D; }
  .step-img { width: 100%; height: 100%; object-fit: contain; object-position: center; padding: 10px; }
  .step-cap { margin-top: 8px; font-size: 13px; color: #A0A5AE; }
  .join-card { position: absolute; inset: 0; padding: 18px 22px; display: grid; align-content: center; gap: 10px; }
  .jc-row { display: flex; gap: 10px; align-items: flex-start; font-size: 13px; line-height: 1.35; color: #CFD2D7; background: #1E2128; border: 1px solid rgba(255,255,255,.08); border-radius: 10px; padding: 8px 10px; }
  .jc-dot { flex: none; margin-top: 6px; width: 7px; height: 7px; border-radius: 50%; background: #3B6BFF; }
  .jc-act { border-color: rgba(59,107,255,.55); color: #ECEEF1; }
</style>
