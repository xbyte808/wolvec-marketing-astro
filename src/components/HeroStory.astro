---
// Hero illustration: a drawn, composed card with example clients. Every line is PM-checked product behaviour (2026-10-21). Not a screenshot of the app.
const handled = [
  { t: '9:00 am', who: 'Chris', what: 'logged his morning session.' },
  { t: '6:12 pm', who: 'Maya', what: 'logged her squat day.' },
  { t: '6:40 pm', who: 'Jordan', what: 'swapped the leg press for today. You were notified.' },
  { t: '8:55 pm', who: 'Riley', what: 'asked what today’s session is. Your AI answered, based on how you coach.', tag: 'Fully autonomous' },
  { t: '9:10 pm', who: 'Sam', what: 'has week 4 drafted and ready for you.' },
];
const needs = [
  { who: 'Jordan', what: 'asked to swap squats at a hotel gym tomorrow.', tag: 'Decide' },
  { who: 'Alex', what: 'has a reply draft waiting.', tag: 'Open' },
  { who: 'Sam’s', what: 'week 4 is ready for your review.', tag: 'Review' },
];
---
<figure class="story" aria-label="Illustration: a coach's evening with example clients">
  <div class="st-card">
    <p class="st-label">Thursday, while you were off</p>
    <ol class="st-feed">
      {handled.map((h) => (
        <li class="st-item"><span class="st-time">{h.t}</span><span class="st-text"><b>{h.who}</b> {h.what}{h.tag && <em class="st-mode">{h.tag}</em>}</span></li>
      ))}
    </ol>
    <div class="st-split"><span>Needs you</span></div>
    <ul class="st-needs">
      {needs.map((n) => (
        <li class="st-need"><span class="st-text"><b>{n.who}</b> {n.what}</span><span class="st-tag">{n.tag}</span></li>
      ))}
    </ul>
  </div>
  <figcaption class="st-cap">Illustration with example clients.</figcaption>
</figure>
<style>
  .story { margin: 40px auto 0; max-width: 540px; width: 100%; text-align: left; }
  @media (min-width: 1024px) { .story { margin: 0; max-width: none; } }
  .st-card { background: #16181D; border: 1px solid rgba(255,255,255,.10); border-radius: 18px; padding: 22px; box-shadow: 0 30px 80px rgba(0,0,0,.45); }
  .st-label { font-size: 12px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: #4272FF; margin: 0 0 12px; }
  .st-feed { list-style: none; margin: 0; padding: 0 0 0 14px; border-left: 1px solid rgba(255,255,255,.12); display: grid; gap: 12px; }
  .st-item { position: relative; display: grid; grid-template-columns: 58px 1fr; gap: 10px; font-size: 14px; line-height: 1.45; color: #A0A5AE; }
  .st-item::before { content: ''; position: absolute; left: -18px; top: 6px; width: 7px; height: 7px; border-radius: 50%; background: #3B6BFF; }
  .st-time { font-size: 12px; color: #6F7580; padding-top: 1px; }
  .st-text b { color: #ECEEF1; font-weight: 600; }
  .st-mode { display: inline-block; margin-left: 6px; font-style: normal; font-size: 12px; color: #CFD2D7; border: 1px solid rgba(255,255,255,.18); border-radius: 999px; padding: 1px 8px; }
  .st-split { display: flex; align-items: center; gap: 10px; margin: 20px 0 12px; font-family: var(--font-display); font-weight: 600; font-size: 20px; color: #ECEEF1; }
  .st-split::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.12); }
  .st-needs { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .st-need { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center; background: #1E2128; border: 1px solid rgba(59,107,255,.35); border-radius: 12px; padding: 11px 12px; font-size: 14px; color: #CFD2D7; }
  .st-tag { font-size: 12px; color: #ECEEF1; background: rgba(59,107,255,.18); border: 1px solid rgba(59,107,255,.5); border-radius: 999px; padding: 3px 10px; white-space: nowrap; }
  .st-cap { margin-top: 10px; font-size: 12px; color: #A0A5AE; text-align: center; }
  @media (max-width: 640px) { .st-item:nth-child(5) { display: none; } }
  @media (max-width: 420px) { .st-need { grid-template-columns: 1fr; } .st-tag { justify-self: start; } .st-item { grid-template-columns: 1fr; gap: 2px; } }
</style>
