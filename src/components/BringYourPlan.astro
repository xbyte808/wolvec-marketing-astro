---
---

<section id="bring-your-plan" class="pt-21 pb-8 px-6 bg-paper-1">
  <div class="max-w-5xl mx-auto">
    <div class="hover-card grid grid-cols-1 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] gap-7 items-center border border-hairline-light rounded-2xl px-7 py-7 md:px-9 md:py-8 bg-paper-2" data-reveal>
      <div class="flex gap-4 items-start">
      <div class="text-azure-deep text-2xl leading-none shrink-0">&#9670;</div>
      <div>
        <h2 class="section-heading text-on-paper text-2xl !mb-1.5">Already writing programs? Bring them.</h2>
        <p class="text-on-paper-soft leading-relaxed text-base max-w-2xl text-balance">
          Upload the programs you already run as spreadsheets, Word (.docx) documents, text-based PDFs or plain text files. Wolvec turns them into templates matched to the exercise catalog, so you are not retyping years of programming. Check each line, then assign.
        </p>
      </div>
      </div>
      <figure class="imp" aria-label="Illustration: a program file becomes a template with lines to check">
        <div class="imp-files">
          <span>.xlsx</span><span>.csv</span><span>.docx</span><span>PDF</span><span>.txt</span>
        </div>
        <div class="imp-arrow" aria-hidden="true">&#8595;</div>
        <div class="imp-card">
          <p class="imp-head">Template: Strength Block A <span class="imp-count">2 lines to confirm</span></p>
          <p class="imp-row"><span>Back squat 4 × 5</span><em>Unconfirmed</em></p>
          <p class="imp-row"><span>Romanian deadlift 3 × 8</span><em>Unconfirmed</em></p>
          <p class="imp-row imp-ok"><span>Walking lunge 3 × 10</span><em>Confirmed</em></p>
        </div>
        <figcaption class="imp-cap">Illustration. Every imported line starts unconfirmed.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .imp { margin: 0; }
  .imp-files { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
  .imp-files span { font-size: 12.5px; font-weight: 600; color: #16181D; background: #EEF0EE; border: 1px solid rgba(13,14,17,.12); border-radius: 8px; padding: 4px 9px; }
  .imp-arrow { text-align: center; color: #2451D9; font-size: 20px; line-height: 1; margin: 8px 0; }
  .imp-card { background: #16181D; border-radius: 14px; padding: 14px; display: grid; gap: 7px; }
  .imp-head { font-family: var(--font-display); font-weight: 600; font-size: 16px; color: #ECEEF1; margin-bottom: 2px; display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  .imp-count { font-family: var(--font-body); font-weight: 500; font-size: 12px; color: #A0A5AE; }
  .imp-row { display: flex; justify-content: space-between; gap: 10px; align-items: center; font-size: 13.5px; color: #CFD2D7; background: #1E2128; border: 1px solid rgba(255,255,255,.08); border-radius: 9px; padding: 8px 10px; }
  .imp-row em { font-style: normal; font-size: 12px; color: #ECEEF1; border: 1px solid rgba(59,107,255,.55); background: rgba(59,107,255,.16); border-radius: 999px; padding: 2px 9px; white-space: nowrap; }
  .imp-ok em { color: #9BE3B4; border-color: rgba(155,227,180,.4); background: transparent; }
  .imp-cap { margin-top: 8px; font-size: 12px; color: #5B6069; text-align: center; }
</style>
