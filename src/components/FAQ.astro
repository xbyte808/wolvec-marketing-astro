---
// The FAQPage JSON-LD in src/pages/index.astro declares exactly the questions
// rendered here. Founder ruling: the three extra schema entries were deleted
// rather than published. Adding a question here means adding it there too.
// COUNSEL-APPROVED VERBATIM 2026-10-19. Do not edit without counsel review. See Standing Decision "MARKETING FAQ WORDING".
const faqs = [
  {
    id: 'what-stays-mine',
    question: 'What stays mine, and what am I responsible for?',
    answer:
      'You retain any ownership rights you have in content you create and provide through Wolvec. Your clients are your clients, and you retain full responsibility for the coaching relationship. You determine whether medical clearance is required and remain responsible for the professional judgment to proceed within your scope of practice. Wolvec provides the platform.',
    defaultOpen: true,
  },
];
---

<section id="faq" class="py-16 px-6 bg-ink">
  <div class="max-w-2xl mx-auto">
    <p class="eyebrow eyebrow-on-ink mb-5" data-reveal>Questions</p>
    <h2 class="section-heading text-text text-3xl" data-reveal style="--reveal-delay:70ms">
      Common questions
    </h2>

    <!--
      Answer text is rendered into the HTML on the server. Collapsing is CSS
      driven and scoped to html.js, so without JavaScript the answer shows.
    -->
    <div class="border-t border-hairline-dark mt-8" data-reveal style="--reveal-delay:140ms">
      {faqs.map((faq) => (
        <div class="border-b border-hairline-dark">
          <h3>
            <button
              type="button"
              class="disclosure-trigger hover-row w-full flex items-center justify-between gap-5 text-left py-5 cursor-pointer hover:bg-surface-1 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-azure"
              id={`faq-trigger-${faq.id}`}
              aria-controls={`faq-panel-${faq.id}`}
              aria-expanded="false"
              data-disclosure-trigger
              data-disclosure-default={faq.defaultOpen ? 'open' : 'closed'}
            >
              <span class="font-display text-text text-[clamp(1.125rem,1vw+0.85rem,1.5rem)] leading-[1.15]">
                {faq.question}
              </span>
              <span
                class="disclosure-icon shrink-0 text-azure text-2xl leading-none select-none"
                aria-hidden="true"
              >
                +
              </span>
            </button>
          </h3>

          <div
            id={`faq-panel-${faq.id}`}
            role="region"
            aria-labelledby={`faq-trigger-${faq.id}`}
            data-disclosure-panel
          >
            <p class="text-text-soft leading-relaxed pb-6 pr-8">
              {faq.answer}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
