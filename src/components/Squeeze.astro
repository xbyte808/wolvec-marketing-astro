---
const points = [
  {
    label: 'Never ending',
    body: 'Workout swaps, form checks, quick questions, every hour, from every client.',
  },
  {
    label: 'Stitched together',
    body: 'A scheduling app, a program spreadsheet, a logging app and a texting thread for check-ins. The work is split across all of them.',
  },
  {
    label: 'Nothing to start with',
    body: 'You may have no book, podcast or course for an AI to learn from. Wolvec starts with one conversation instead.',
  },
];

// Optional photo: renders only when src/assets/photos/problem-coach.(jpg|jpeg|png|webp) exists.
// Source and licence for every photo are recorded in src/assets/photos/LICENSES.md.
import { Image } from 'astro:assets';
const problemPhoto = Object.values(
  import.meta.glob('../assets/photos/problem-coach.{jpg,jpeg,png,webp}', { eager: true, import: 'default' }),
)[0] as ImageMetadata | undefined;
---

<section id="squeeze" class="py-21 px-6 bg-paper-1 text-on-paper">
  <div class="max-w-5xl mx-auto">
    <h2 class="section-heading text-on-paper mb-11 max-w-2xl text-[clamp(1.875rem,3vw+1rem,2.75rem)]" data-reveal>
      Why coaches hit a ceiling
    </h2>

    {problemPhoto && (
      <figure class="photo-band" data-reveal>
        <Image src={problemPhoto} alt="" width={1600} format="webp" quality={75} class="photo-band-img" />
      </figure>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {points.map((p, i) => (
        <div class="hover-card border border-hairline-light rounded-2xl p-6 bg-paper-2" data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <h3 class="font-display text-on-paper text-xl mb-2">{p.label}</h3>
          <p class="text-on-paper-soft text-[15.5px] leading-relaxed">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .photo-band { margin: 0 0 24px; height: clamp(180px, 22vw, 280px); border-radius: 18px; overflow: hidden; }
  .photo-band-img { width: 100%; height: 100%; object-fit: cover; object-position: var(--photo-pos, 50% 60%); }
</style>
