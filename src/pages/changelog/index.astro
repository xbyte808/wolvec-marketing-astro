---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Changelog | Wolvec"
  description="Notable changes to the Wolvec platform, posted here as they ship."
>
  <main class="pt-32 pb-24 px-6 min-h-screen">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="text-4xl font-bold text-white mb-4">Changelog</h1>
      <p class="text-neutral-400 text-lg mb-6">
        We ship in public. Notable changes to the platform are posted here.
      </p>
      <p class="text-neutral-400 mb-8">
        No entries yet. The first ones go up as changes ship.
      </p>
      <a
        href="/#how-it-works"
        class="inline-block text-brand-accent hover:text-brand-accent/80 font-semibold transition-colors"
      >
        See how Wolvec works &rarr;
      </a>
    </div>
  </main>
</Layout>
