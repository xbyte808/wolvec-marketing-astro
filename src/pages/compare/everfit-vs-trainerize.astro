<script>
  // Tables wider than the screen scroll sideways inside their box. This darkens the edge on the
  // side that has more columns, so the scroll is visible on phones with hidden scrollbars.
  // (Wording and the ResizeObserver are deliberate: Tailwind scans this file, and bare utility
  // names in it would add classes to the shared stylesheet and change every other page.)
  document.querySelectorAll<HTMLElement>('[data-scroll-cue]').forEach((wrap) => {
    const outer = wrap.parentElement;
    if (!outer) return;
    const update = () => {
      const max = wrap.scrollWidth - wrap.clientWidth;
      outer.classList.toggle('c-more-right', max > 1 && wrap.scrollLeft < max - 1);
      outer.classList.toggle('c-more-left', max > 1 && wrap.scrollLeft > 1);
    };
    wrap.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(wrap);
    update();
  });
</script>

