---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import Squeeze from '../components/Squeeze.astro';
import HowItWorks from '../components/HowItWorks.astro';
import BringYourPlan from '../components/BringYourPlan.astro';
import YourControl from '../components/YourControl.astro';
import Safety from '../components/Safety.astro';
import Platform from '../components/Platform.astro';
import ClientExperience from '../components/ClientExperience.astro';
import EarlyAccessCTA from '../components/EarlyAccessCTA';
import FAQ from '../components/FAQ.astro';
import { Image } from 'astro:assets';
import earlyAccessPhoto from '../assets/photos/early-access.jpg';
---

<Layout
  title="Add Clients, Not Hours | Wolvec AI Coaching for Fitness Coaches"
  description="Wolvec builds your AI from one conversation, no content library required. It handles client chat and check-ins in your voice; you decide how much it runs."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Wolvec",
      "url": "https://wolvec.ai",
      "logo": "https://wolvec.ai/wolvec-logo-mark.png",
      "description": "Wolvec is the coach's whole coaching setup, not an add-on to it. It's built through one structured conversation, no existing content library required, and it runs the everyday with clients in the coach's voice.",
      "email": "ellard@wolvec.ai"
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Wolvec",
      "description": "The coach's whole coaching setup, run through an AI built from one structured conversation, no existing content library required. Handles client check-ins, Q&A, programs, and accountability between sessions.",
      "provider": {
        "@type": "Organization",
        "name": "Wolvec"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Online fitness coaches"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Wolvec",
      "url": "https://wolvec.ai",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "Wolvec is the coach's whole coaching setup, not an add-on to it. It's built through one structured conversation, no existing content library required, and it runs the everyday with clients in the coach's voice.",
      "publisher": {
        "@type": "Organization",
        "name": "Wolvec"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Wolvec?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wolvec is the coach's whole coaching setup, not an add-on to it. One structured conversation builds the coach's AI, no existing content library required, and it runs the everyday with clients: check-ins, routine questions, programs, and accountability between sessions."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a content library to use Wolvec?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Wolvec builds your AI through one structured conversation. Coaches who are new to online coaching and have no existing content can use Wolvec from day one."
          }
        },
        {
          "@type": "Question",
          "name": "How does Wolvec handle client safety?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Any client message that mentions pain, injury, illness, or dizziness is automatically escalated to the coach with a recommendation to consult a medical professional. The AI doesn't independently handle conversations where safety is on the line. Every new client also completes PAR-Q+ pre-participation health screening, and the coach reviews those responses before the AI begins full interaction."
          }
        },
        {
          "@type": "Question",
          "name": "Who owns the data?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Coaches own their methodology and their client relationships. Wolvec provides the platform. Clinical decisions, medical-clearance calls, and scope-of-practice boundaries stay with the coach."
          }
        }
      ]
    })} />
  </Fragment>

  <main>
    <Hero />
    <StatsBar />
    <Squeeze />
    <HowItWorks />
    <BringYourPlan />
    <YourControl />
    <Safety />
    <Platform />
    <ClientExperience />

    <!-- About Wolvec — for AI summarizers and search crawlers -->
    <section id="about" class="py-16 px-6 bg-ink">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-text-soft text-sm leading-relaxed">
          Wolvec is the coach's whole coaching setup, not an add-on to it. It creates an AI
          version of the coach through one structured conversation, no existing content library
          required, and it runs the everyday with clients: check-ins, routine questions, programs,
          and accountability between sessions. The coach controls which supported categories
          of interaction the AI handles, and Wolvec uses limited safety controls for certain physical health concerns.
        </p>
      </div>
    </section>

    <FAQ />

    <!-- Early Access Section -->
    <section id="early-access" class="relative overflow-hidden py-26 px-6 text-center">
      <Image
        src={earlyAccessPhoto}
        alt=""
        width={1920}
        height={1000}
        format="webp"
        quality={75}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
        style="filter: grayscale(0.4) brightness(0.36)"
      />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(13,14,17,.7),rgba(13,14,17,.94))]"></div>

      <div class="relative max-w-2xl mx-auto">
        <p class="font-label text-azure text-xs uppercase tracking-[0.24em] mb-3">
          Early access &middot; limited cohort
        </p>
        <h2 class="font-display text-white text-[clamp(2.375rem,5vw+1rem,4.5rem)] leading-[0.92] mb-4">
          Be one of the first coaches on <span class="text-white">Wolvec</span>.
        </h2>
        <p class="text-[#D6D8DD] text-lg mb-9 max-w-md mx-auto text-balance">
          We're opening Wolvec to a small group of founding coaches before broader
          availability.
        </p>

        <div class="bg-surface-1/90 backdrop-blur-md border border-hairline-dark rounded-[22px] p-6 md:p-8 text-left">
          <EarlyAccessCTA client:load />
        </div>

        <div class="flex flex-wrap gap-6 justify-center mt-7 text-sm text-[#B7BAC1]">
          <span class="inline-flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-azure"></span> 14-day free trial
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-azure"></span> No card required to start
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-azure"></span> Founding-coach discount
          </span>
        </div>
      </div>
    </section>
  </main>
</Layout>
