---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import Squeeze from '../components/Squeeze.astro';
import HowItWorks from '../components/HowItWorks.astro';
import BringYourPlan from '../components/BringYourPlan.astro';
import YourControl from '../components/YourControl.astro';
import Safety from '../components/Safety.astro';
import Platform from '../components/Platform.astro';
import ClientExperience from '../components/ClientExperience.astro';
import EarlyAccessCTA from '../components/EarlyAccessCTA';
import FAQ from '../components/FAQ.astro';
import { faqs } from '../data/faqs';

// One canonical identifier for the company. Every Organization node that can
// be reached from this file either IS this node or is a reference to it, so
// consumers resolve them to a single entity instead of several look-alikes.
//
// Out of reach from here: the publisher nodes inside the WebPage schema on
// /privacy and /consumer-health-data. Those are counsel-owned files and are
// deliberately left untouched.
const ORG_ID = 'https://wolvec.ai/#organization';
---

<Layout
  title="Wolvec | AI platform for fitness coaches"
  description="Wolvec is the AI platform for fitness coaches. Your AI is built from one conversation about how you coach, no content library required. You set how much it handles."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": ORG_ID,
      "name": "Wolvec",
      "url": "https://wolvec.ai",
      "logo": "https://wolvec.ai/wolvec-logo-mark.png",
      "description": "Wolvec is an AI platform for fitness coaches, the whole coaching setup rather than an add-on to it. Each coach's AI is set up from one guided conversation about how they coach, with no existing content library required, then works from it to draft programs and answer routine client questions. It also includes workout logging and weekly check-ins.",
      "email": "ellard@wolvec.ai"
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Wolvec",
      "description": "An AI platform for fitness coaches. The coach's AI is set up from one guided conversation about how they coach, with no existing content library required. Includes AI-drafted programs, workout logging, weekly check-ins, and client chat with AI replies at the level the coach sets.",
      "provider": {
        "@type": "Organization",
        "@id": ORG_ID,
        "name": "Wolvec"
      },
      "audience": {
        "@type": "Audience",
        "audienceType": "Online fitness coaches"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Wolvec",
      "url": "https://wolvec.ai",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "Wolvec is an AI platform for fitness coaches, the whole coaching setup rather than an add-on to it. Each coach's AI is set up from one guided conversation about how they coach, with no existing content library required, then works from it to draft programs and answer routine client questions. It also includes workout logging and weekly check-ins.",
      "publisher": {
        "@type": "Organization",
        "@id": ORG_ID,
        "name": "Wolvec"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      // Built from src/data/faqs.ts, the same array src/components/FAQ.astro
      // renders, so the structured data always matches the visible FAQ.
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.question,
        "acceptedAnswer": { "@type": "Answer", "text": f.answer },
      }))
    })} />
  </Fragment>

  <main>
    <Hero />
    <Squeeze />
    <HowItWorks />
    <BringYourPlan />
    <YourControl />
    <Platform />
    <ClientExperience />
    <Safety />


    <FAQ />

    <!--
      Early Access Section. The page's primary call to action.

      Was a solid azure field. It won the page: the eye landed on the ground
      instead of the form. Primacy is now carried by elevation rather than
      hue. The ground is ink, continuous with the dark run above it, and the
      azure is spent only where it points at the form -- a glow behind the
      panel and a tinted edge on it. The panel is the lightest surface on the
      page and its submit button the only saturated fill, so the form is what
      the eye reaches first. Section and form are otherwise unchanged.
    -->
    <section id="early-access" class="early-access relative overflow-hidden py-26 px-6 text-center">
      <div class="early-access-wash absolute inset-0" aria-hidden="true"></div>

      <div class="relative max-w-2xl mx-auto">
        <p class="early-access-eyebrow" data-reveal>
          Early access
        </p>
        <h2
          class="section-heading text-white text-[clamp(2.375rem,5vw+1rem,4.5rem)] !leading-[0.92] !mb-4"
          data-reveal
          style="--reveal-delay:70ms"
        >
          Be one of the first coaches on <span class="text-white">Wolvec</span>.
        </h2>
        <p
          class="section-lede text-white/85 text-lg mb-9 max-w-md mx-auto text-balance"
          data-reveal
          style="--reveal-delay:140ms"
        >
          We're letting a small group of coaches in first, before Wolvec opens to everyone.
        </p>

        <div
          class="early-access-panel rounded-[22px] p-6 md:p-8 text-left"
          data-reveal
          style="--reveal-delay:210ms"
        >
          <EarlyAccessCTA client:load />

          <div class="flex flex-wrap gap-6 justify-center mt-6 pt-6 border-t border-white/10 text-sm text-white/85">
            <span class="inline-flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-azure"></span> Every coach gets a 14-day free trial
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-azure"></span> No card required to start
            </span>
          </div>
        </div>
      </div>
    </section>
    <!-- About Wolvec — for AI summarizers and search crawlers -->
    <section id="about" class="pt-4 pb-14 px-6 bg-ink">
      <div class="max-w-2xl mx-auto text-center" data-reveal>
        <p class="section-lede text-text-soft text-[13px] leading-relaxed">
          Wolvec is an AI platform for fitness coaches, the whole coaching setup rather than an add-on to it. Each coach's AI is set up from one guided conversation about how they coach, with no existing content library required, then works from it to draft programs and answer routine client questions. It also includes workout logging and weekly check-ins. The coach sets how much client chat the AI may handle, and Wolvec uses limited safety controls for certain physical health concerns.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Ink ground. The section above it is also ink, so the hairline and the
     glow, not a colour change, are what separate them. */
  .early-access {
    background: var(--color-ink);
    border-top: 1px solid var(--color-hairline-dark);
  }

  /* The glow sits behind an opaque panel, so it reads as a halo thrown by
     the form rather than a field the form is floating on. */
  .early-access-wash {
    background:
      radial-gradient(
        ellipse 76% 62% at 50% 54%,
        rgba(59, 107, 255, 0.26),
        rgba(59, 107, 255, 0.08) 48%,
        transparent 76%
      ),
      radial-gradient(
        ellipse 130% 44% at 50% 0%,
        rgba(59, 107, 255, 0.07),
        transparent 72%
      );
  }

  /* Lightest surface on the page. The form's own inputs are ink, so they sit
     as wells inside it, and its submit button is the only saturated fill in
     the section. */
  .early-access-panel {
    background: var(--color-surface-1);
    border: 1px solid rgba(94, 133, 255, 0.32);
    box-shadow:
      0 30px 70px -24px rgba(0, 0, 0, 0.85),
      0 0 70px -18px rgba(59, 107, 255, 0.35);
  }

  /*
    The only eyebrow on the site that is not azure. It was white because the
    ground was azure; the ground is ink now, but the exception is retained by
    founder ruling. White on ink measures 19.3:1.
  */
  .early-access-eyebrow {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 22px;
  }
</style>
